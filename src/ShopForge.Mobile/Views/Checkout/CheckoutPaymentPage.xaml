<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Checkout.CheckoutPaymentPage"
             Title="Payment">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Card Details" Style="{StaticResource HeadingLabel}" />
            <Entry Placeholder="Cardholder Name" Text="{Binding CardHolder}" />
            <Entry Placeholder="Card Number" Text="{Binding CardNumber}" Keyboard="Numeric" MaxLength="19" />
            <Label Text="{Binding DetectedCardBrand}" TextColor="{StaticResource Primary}" FontAttributes="Bold"
                   IsVisible="{Binding DetectedCardBrand, Converter={StaticResource NullToVisibilityConverter}}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="MM" Text="{Binding ExpiryMonth}" Keyboard="Numeric" MaxLength="2" />
                <Entry Grid.Column="1" Placeholder="YYYY" Text="{Binding ExpiryYear}" Keyboard="Numeric" MaxLength="4" />
                <Entry Grid.Column="2" Placeholder="CVV" Text="{Binding Cvv}" Keyboard="Numeric" MaxLength="4" IsPassword="True" />
            </Grid>

            <Label Text="Demo Cards:" TextColor="{StaticResource Gray600}" FontSize="12" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding DemoCards}" HeightRequest="80">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" FontSize="11" TextColor="{StaticResource Gray600}" Padding="0,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyDemoCardCommand}" CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <Button Text="Pay Now" Command="{Binding PayCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>