<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:ShopForge.Shared.DTOs.Products;assembly=ShopForge.Shared"
             x:Class="ShopForge.Mobile.Views.Home.HomePage"
             Title="ShopForge">
    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <!-- Hero / Banners -->
                <CarouselView ItemsSource="{Binding Banners}" HeightRequest="200" Loop="False"
                              IsVisible="{Binding Banners.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                <VerticalStackLayout VerticalOptions="End" Padding="16" BackgroundColor="#80000000">
                                    <Label Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding SubTitle}" TextColor="White" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!-- Categories -->
                <VerticalStackLayout Padding="16,12,16,4">
                    <Label Text="Categories" Style="{StaticResource HeadingLabel}" Margin="0,0,0,8" />
                    <CollectionView ItemsSource="{Binding Categories}" HeightRequest="100"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="4" Padding="8" WidthRequest="80">
                                    <Frame CornerRadius="40" Padding="0" HeightRequest="60" WidthRequest="60"
                                           HorizontalOptions="Center" BackgroundColor="{StaticResource Gray200}" HasShadow="False">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Frame>
                                    <Label Text="{Binding Name}" FontSize="11" HorizontalOptions="Center"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToCategoryCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Featured Products -->
                <VerticalStackLayout Padding="16,8,16,4">
                    <Label Text="Featured Products" Style="{StaticResource HeadingLabel}" Margin="0,0,0,8" />
                    <CollectionView ItemsSource="{Binding FeaturedProducts}" HeightRequest="260"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="160">
                                    <Frame BackgroundColor="White" CornerRadius="12" Padding="0" HasShadow="True" Margin="4">
                                        <VerticalStackLayout>
                                            <Image Source="{Binding PrimaryImageUrl}" Aspect="AspectFill" HeightRequest="120" BackgroundColor="{StaticResource Gray200}" />
                                            <VerticalStackLayout Padding="8" Spacing="2">
                                                <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" FontAttributes="Bold" FontSize="12" />
                                                <Label Text="{Binding Price, StringFormat='R{0:N2}'}" TextColor="{StaticResource Accent}" FontAttributes="Bold" FontSize="14" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToProductCommand}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- New Arrivals -->
                <VerticalStackLayout Padding="16,8,16,4">
                    <Label Text="New Arrivals" Style="{StaticResource HeadingLabel}" Margin="0,0,0,8" />
                    <CollectionView ItemsSource="{Binding NewArrivals}" HeightRequest="260"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="160">
                                    <Frame BackgroundColor="White" CornerRadius="12" Padding="0" HasShadow="True" Margin="4">
                                        <VerticalStackLayout>
                                            <Image Source="{Binding PrimaryImageUrl}" Aspect="AspectFill" HeightRequest="120" BackgroundColor="{StaticResource Gray200}" />
                                            <VerticalStackLayout Padding="8" Spacing="2">
                                                <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" FontAttributes="Bold" FontSize="12" />
                                                <Label Text="{Binding Price, StringFormat='R{0:N2}'}" TextColor="{StaticResource Accent}" FontAttributes="Bold" FontSize="14" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToProductCommand}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Special Offers -->
                <VerticalStackLayout Padding="16,8,16,16">
                    <Label Text="Special Offers" Style="{StaticResource HeadingLabel}" Margin="0,0,0,8"
                           IsVisible="{Binding SpecialOffers.Count, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <CollectionView ItemsSource="{Binding SpecialOffers}" HeightRequest="260"
                                    ItemsLayout="HorizontalList"
                                    IsVisible="{Binding SpecialOffers.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="160">
                                    <Frame BackgroundColor="White" CornerRadius="12" Padding="0" HasShadow="True" Margin="4">
                                        <VerticalStackLayout>
                                            <Image Source="{Binding PrimaryImageUrl}" Aspect="AspectFill" HeightRequest="120" BackgroundColor="{StaticResource Gray200}" />
                                            <VerticalStackLayout Padding="8" Spacing="2">
                                                <Label Text="{Binding Name}" MaxLines="2" LineBreakMode="TailTruncation" FontAttributes="Bold" FontSize="12" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Price, StringFormat='R{0:N2}'}" TextColor="{StaticResource Accent}" FontAttributes="Bold" FontSize="14" />
                                                    <Label Text="{Binding CompareAtPrice, StringFormat='R{0:N2}'}" TextDecorations="Strikethrough" TextColor="{StaticResource Gray400}" FontSize="11" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToProductCommand}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" HorizontalOptions="Center" Margin="20" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>