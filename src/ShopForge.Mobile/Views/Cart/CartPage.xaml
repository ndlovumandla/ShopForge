<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Cart.CartPage"
             Title="My Cart">
    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0" Command="{Binding LoadCartCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Cart.Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="40">
                        <Label Text="&#x1F6D2;" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Your cart is empty" FontSize="18" HorizontalOptions="Center" TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Remove" BackgroundColor="{StaticResource Error}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                               CommandParameter="{Binding Id}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Source="{Binding ProductImageUrl}" WidthRequest="70" HeightRequest="70" Aspect="AspectFill" BackgroundColor="{StaticResource Gray200}" />
                                <VerticalStackLayout Grid.Column="1" Padding="12,0" Spacing="2">
                                    <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="13" MaxLines="2" />
                                    <Label Text="{Binding VariantName}" TextColor="{StaticResource Gray600}" FontSize="11" />
                                    <Label Text="{Binding UnitPrice, StringFormat='R{0:N2}'}" TextColor="{StaticResource Accent}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Button Text="-" WidthRequest="28" HeightRequest="28" CornerRadius="6"
                                                FontSize="14" Padding="0"
                                                BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseItemQuantityCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Text="{Binding Quantity}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Button Text="+" WidthRequest="28" HeightRequest="28" CornerRadius="6"
                                                FontSize="14" Padding="0"
                                                BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseItemQuantityCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TotalPrice, StringFormat='R{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Gray900}" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Summary + Checkout -->
        <VerticalStackLayout Grid.Row="1" Padding="16" BackgroundColor="White" Spacing="8">
            <!-- Coupon -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Coupon code" Text="{Binding CouponCode}" />
                <Button Grid.Column="1" Text="Apply" Command="{Binding ApplyCouponCommand}"
                        Style="{StaticResource AccentButton}" WidthRequest="80" />
            </Grid>
                <Button Text="Remove Coupon" Command="{Binding RemoveCouponCommand}"
                    IsVisible="{Binding Cart.CouponCode, Converter={StaticResource NullToVisibilityConverter}}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                    HorizontalOptions="Start" Padding="0,4" />
            <Label Text="{Binding CouponError}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding CouponError, Converter={StaticResource NullToVisibilityConverter}}" FontSize="12" />

            <!-- Totals -->
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Subtotal" TextColor="{StaticResource Gray600}" />
                <Label Grid.Column="1" Text="{Binding Cart.SubTotal, StringFormat='R{0:N2}'}" FontAttributes="Bold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Cart.DiscountAmount, Converter={StaticResource BoolToVisibilityConverter}}">
                <Label Grid.Column="0" Text="Discount" TextColor="{StaticResource Success}" />
                <Label Grid.Column="1" Text="{Binding Cart.DiscountAmount, StringFormat='-R{0:N2}'}" TextColor="{StaticResource Success}" FontAttributes="Bold" />
            </Grid>
            <Button Text="Proceed to Checkout" Command="{Binding CheckoutCommand}"
                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>