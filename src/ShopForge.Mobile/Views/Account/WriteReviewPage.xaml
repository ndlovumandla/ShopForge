<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Account.WriteReviewPage"
             Title="Write Review">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <!-- Star Rating -->
            <Label Text="Rating" Style="{StaticResource HeadingLabel}" FontSize="16" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="&#x2605;" Command="{Binding SetRatingCommand}" CommandParameter="1"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}" FontSize="28" Padding="0" />
                <Button Text="&#x2605;" Command="{Binding SetRatingCommand}" CommandParameter="2"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}" FontSize="28" Padding="0" />
                <Button Text="&#x2605;" Command="{Binding SetRatingCommand}" CommandParameter="3"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}" FontSize="28" Padding="0" />
                <Button Text="&#x2605;" Command="{Binding SetRatingCommand}" CommandParameter="4"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}" FontSize="28" Padding="0" />
                <Button Text="&#x2605;" Command="{Binding SetRatingCommand}" CommandParameter="5"
                        BackgroundColor="Transparent" TextColor="{StaticResource Warning}" FontSize="28" Padding="0" />
                <Label Text="{Binding Rating, StringFormat='{0}/5'}" VerticalOptions="Center" FontSize="14" />
            </HorizontalStackLayout>
            <Entry Placeholder="Review Title" Text="{Binding Title}" />
            <Editor Placeholder="Write your review..." Text="{Binding Body}" HeightRequest="120"
                    BackgroundColor="{StaticResource Gray100}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <Button Text="Submit Review" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
            <Label Text="&#x2705; Review submitted!" FontSize="18" TextColor="{StaticResource Success}"
                   HorizontalOptions="Center" IsVisible="{Binding Submitted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>