<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Auth.ForgotPasswordPage"
             Title="Forgot Password"
             BackgroundColor="{StaticResource White}">
    <VerticalStackLayout Padding="32,60,32,32" Spacing="16">
        <Label Text="Forgot Password" FontSize="28" FontAttributes="Bold"
               TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
        <Label Text="Enter your email and we'll send you a reset link."
               TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
        <VerticalStackLayout IsVisible="{Binding EmailSent, Converter={StaticResource InvertedBoolConverter}}" Spacing="12">
            <Entry Placeholder="Email address" Text="{Binding Email}" Keyboard="Email" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <Button Text="Send Reset Link" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding EmailSent}" Spacing="12">
            <Label Text="&#x2705; Reset link sent!" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Success}" HorizontalOptions="Center" />
            <Label Text="Check your email for the reset link." TextColor="{StaticResource Gray600}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>