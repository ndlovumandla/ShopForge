<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Auth.LoginPage"
             Title="Sign In"
             BackgroundColor="{StaticResource White}">
    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,32" Spacing="16">
            <Label Text="ShopForge" FontSize="36" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
            <Label Text="Sign in to your account" FontSize="16" TextColor="{StaticResource Gray600}"
                   HorizontalOptions="Center" Margin="0,0,0,24" />
            <Entry Placeholder="Email address" Text="{Binding Email}" Keyboard="Email" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0" Placeholder="Password" Text="{Binding Password}"
                       IsPassword="{Binding ShowPassword, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="1" Text="&#x1F441;" Command="{Binding TogglePasswordVisibilityCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Gray600}" />
            </Grid>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <Button Text="Sign In" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />
            <Button Text="Forgot Password?" Command="{Binding GoToForgotPasswordCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Don't have an account?" TextColor="{StaticResource Gray600}" />
                <Label Text="Register" TextColor="{StaticResource Primary}" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>