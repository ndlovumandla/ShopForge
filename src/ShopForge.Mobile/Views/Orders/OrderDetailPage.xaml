<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopForge.Mobile.Views.Orders.OrderDetailPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
            <VerticalStackLayout IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" Spacing="12">
                <!-- Status -->
                <Frame Padding="16" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Order.OrderNumber, StringFormat='Order #{0}'}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Order.CreatedAt, StringFormat='{0:MMM dd, yyyy HH:mm}'}" TextColor="{StaticResource Gray600}" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Order.Status}"
                               TextColor="{Binding Order.Status, Converter={StaticResource StringToColorConverter}}"
                               FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Items -->
                <Label Text="Items" Style="{StaticResource HeadingLabel}" FontSize="16" />
                <CollectionView ItemsSource="{Binding Order.Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Source="{Binding ProductImageUrl}" WidthRequest="60" HeightRequest="60" Aspect="AspectFill" BackgroundColor="{StaticResource Gray200}" />
                                <VerticalStackLayout Grid.Column="1" Padding="12,0" Spacing="2">
                                    <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" TextColor="{StaticResource Gray600}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='R{0:N2}'}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Totals -->
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Subtotal" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Column="1" Text="{Binding Order.SubTotal, StringFormat='R{0:N2}'}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Shipping" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Column="1" Text="{Binding Order.ShippingCost, StringFormat='R{0:N2}'}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Total" FontAttributes="Bold" FontSize="16" />
                    <Label Grid.Column="1" Text="{Binding Order.TotalAmount, StringFormat='R{0:N2}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Accent}" />
                </Grid>

                <!-- Pending Order Actions -->
                <Button Text="Pay Now" Command="{Binding PayOrderCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" Padding="16,12"
                    IsVisible="{Binding CanPayOrder}"
                    Margin="0,8,0,0" />
                <Button Text="Cancel Order" Command="{Binding CancelOrderCommand}"
                        BackgroundColor="{StaticResource Error}" TextColor="White" CornerRadius="8" Padding="16,12"
                    IsVisible="{Binding CanCancelOrder}"
                        Margin="0,8,0,0" />
                <Button Text="Reorder Items" Command="{Binding ReorderCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" Padding="16,12"
                    IsVisible="{Binding CanReorder}" />
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>