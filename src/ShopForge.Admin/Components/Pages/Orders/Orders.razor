@page "/orders"
@rendermode InteractiveServer
@inject IAdminApiService ApiService
@inject IAdminAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Orders</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Orders</MudText>

<MudCard Elevation="2">
    <MudCardContent>
        <MudStack Row="true" Class="mb-3">
            <MudTextField @bind-Value="_search" Label="Search order #" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" />
            <MudSelect @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Style="min-width:160px" T="string?">
                <MudSelectItem T="string?" Value="@((string?)null)">All</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Pending")">Pending</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Processing")">Processing</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Shipped")">Shipped</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Delivered")">Delivered</MudSelectItem>
                <MudSelectItem T="string?" Value="@("Cancelled")">Cancelled</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="LoadOrders">Filter</MudButton>
        </MudStack>

        <MudTable Items="_orders" Dense="true" Hover="true" Loading="_loading">
            <HeaderContent>
                <MudTh>Order #</MudTh>
                <MudTh>Items</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.OrderNumber</MudTd>
                <MudTd>@context.ItemCount items</MudTd>
                <MudTd>R @context.TotalAmount.ToString("N2")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small">@context.Status</MudChip></MudTd>
                <MudTd>@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/orders/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No orders found.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-3" />
    </MudCardContent>
</MudCard>

@code {
    private List<OrderSummaryDto> _orders = new();
    private string? _search;
    private string? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.Token != null) ApiService.SetToken(AuthService.Token);
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        var result = await ApiService.GetOrdersAsync(_page, 20, _search, _statusFilter);
        if (result?.Data != null)
        {
            _orders = result.Data.Items;
            _totalPages = result.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadOrders();
    }
}
