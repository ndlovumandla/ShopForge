@page "/settings"
@rendermode InteractiveServer
@inject IAdminApiService ApiService
@inject IAdminAuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Settings</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudCard Elevation="2">
        <MudCardContent>
            <MudGrid>
                @foreach (var setting in _settings)
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="setting.Value" Label="@setting.Key" HelperText="@setting.Description" Variant="Variant.Outlined" />
                    </MudItem>
                }
            </MudGrid>
        </MudCardContent>
        <MudCardActions Class="px-4 pb-4">
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Save Settings
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private List<AppSettingDto> _settings = new();
    private bool _loading = false;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.Token != null) ApiService.SetToken(AuthService.Token);
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var result = await ApiService.GetSettingsAsync();
        _settings = result?.Data ?? new();
        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        var dict = _settings.ToDictionary(s => s.Key, s => s.Value);
        var result = await ApiService.UpdateSettingsAsync(new UpdateSettingsRequest { Settings = dict });
        if (result?.Success == true) Snackbar.Add("Settings saved", Severity.Success);
        else Snackbar.Add(result?.Message ?? "Save failed", Severity.Error);
        _saving = false;
    }
}
