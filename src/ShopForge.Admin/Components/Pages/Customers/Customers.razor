@page "/customers"
@rendermode InteractiveServer
@inject IAdminApiService ApiService
@inject IAdminAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Customers</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Customers</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateCustomerDialog">
        Add Customer
    </MudButton>
</MudStack>

<MudCard Elevation="2">
    <MudCardContent>
        <MudStack Row="true" Class="mb-3">
            <MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="LoadCustomers" />
        </MudStack>

        <MudTable Items="_customers" Dense="true" Hover="true" Loading="_loading">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Orders</MudTh>
                <MudTh>Total Spent</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FirstName @context.LastName</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.Role</MudTd>
                <MudTd>@context.OrderCount</MudTd>
                <MudTd>R @context.TotalSpent.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Size="Size.Small" OnClick="() => ToggleActive(context.Id)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No customers found.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-3" />
    </MudCardContent>
</MudCard>

@code {
    private List<AdminUserDto> _customers = new();
    private string? _search;
    private int _page = 1;
    private int _totalPages = 1;
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.Token != null) ApiService.SetToken(AuthService.Token);
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        var result = await ApiService.GetCustomersAsync(_page, 20, _search);
        if (result?.Data != null)
        {
            _customers = result.Data.Items;
            _totalPages = result.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadCustomers();
    }

    private async Task ToggleActive(int id)
    {
        var result = await ApiService.ToggleCustomerActiveAsync(id);
        if (result?.Success == true)
        {
            Snackbar.Add("Customer updated", Severity.Success);
            await LoadCustomers();
        }
    }

    private async Task OpenCreateCustomerDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateCustomerDialog>("Create Customer");
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is RegisterRequest request)
        {
            var response = await ApiService.RegisterCustomerAsync(request);
            if (response?.Success == true)
            {
                Snackbar.Add("Customer account created.", Severity.Success);
                await LoadCustomers();
                return;
            }

            Snackbar.Add(response?.Message ?? "Unable to create customer account.", Severity.Error);
        }
    }
}
