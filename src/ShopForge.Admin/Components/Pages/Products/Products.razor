@page "/products"
@rendermode InteractiveServer
@inject IAdminApiService ApiService
@inject IAdminAuthService AuthService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Products</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Products</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/products/new">Add Product</MudButton>
</MudStack>

<MudCard Elevation="2">
    <MudCardContent>
        <MudStack Row="true" Class="mb-3">
            <MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="LoadProducts" />
            <MudSelect @bind-Value="_categoryFilter" Label="Category" Variant="Variant.Outlined" Style="min-width:160px" T="int?">
                <MudSelectItem T="int?" Value="@((int?)null)">All Categories</MudSelectItem>
                @foreach (var cat in _categories)
                {
                    <MudSelectItem T="int?" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="LoadProducts">Filter</MudButton>
        </MudStack>

        <MudTable Items="_products" Dense="true" Hover="true" Loading="_loading">
            <HeaderContent>
                <MudTh>Image</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>SKU</MudTh>
                <MudTh>Category</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Stock</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.PrimaryImageUrl))
                    {
                        <MudAvatar><img src="@context.PrimaryImageUrl" style="width:100%;height:100%;object-fit:cover;" /></MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Color="Color.Secondary">@context.Name[0]</MudAvatar>
                    }
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.SKU</MudTd>
                <MudTd>@context.CategoryName</MudTd>
                <MudTd>R @context.Price.ToString("N2")</MudTd>
                <MudTd>
                    <MudText Color="@(context.StockQuantity <= context.LowStockThreshold ? Color.Error : Color.Default)">
                        @context.StockQuantity
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditProduct(context.Id)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteProduct(context.Id)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No products found.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChanged" Class="mt-3" />
    </MudCardContent>
</MudCard>

@code {
    private List<ProductSummaryDto> _products = new();
    private List<CategoryDto> _categories = new();
    private string? _search;
    private int? _categoryFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.Token != null) ApiService.SetToken(AuthService.Token);
        var cats = await ApiService.GetCategoriesAsync();
        _categories = cats?.Data ?? new();
        await LoadProducts();
    }

    private void EditProduct(int id) => Nav.NavigateTo($"/products/{id}/edit");

    private async Task LoadProducts()
    {
        _loading = true;
        var result = await ApiService.GetProductsAsync(_page, 20, _search, _categoryFilter);
        if (result?.Data != null)
        {
            _products = result.Data.Items;
            _totalPages = result.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadProducts();
    }

    private async Task DeleteProduct(int id)
    {
        var result = await ApiService.DeleteProductAsync(id);
        if (result?.Success == true)
        {
            Snackbar.Add("Product deleted", Severity.Success);
            await LoadProducts();
        }
        else
        {
            Snackbar.Add("Delete failed", Severity.Error);
        }
    }
}
