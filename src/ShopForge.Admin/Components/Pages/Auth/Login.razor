@page "/login"
@layout BlankLayout
@rendermode InteractiveServer
@inject IAdminApiService ApiService
@inject IAdminAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center">ShopForge Admin</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">Sign in to continue</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="px-4 pb-4">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="DoLogin" Disabled="_loading">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Sign In
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm? _form;
    private string _email = "";
    private string _password = "";
    private bool _loading = false;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
            Nav.NavigateTo("/dashboard");
    }

    private async Task DoLogin()
    {
        _loading = true;
        try
        {
            var result = await ApiService.LoginAsync(new LoginRequest { Email = _email, Password = _password });
            if (result?.Success == true && result.Data != null)
            {
                var user = result.Data.User;
                if (!string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(user.Role, "Manager", StringComparison.OrdinalIgnoreCase))
                {
                    Snackbar.Add("This account does not have admin portal access.", Severity.Error);
                    return;
                }

                var userName = $"{user.FirstName} {user.LastName}";
                await JS.InvokeVoidAsync("shopForgeAuth.setSession", result.Data.AccessToken, result.Data.RefreshToken, user.Id, userName, user.Role);
                AuthService.SetAuth(result.Data.AccessToken, result.Data.RefreshToken, user.Id, userName, user.Role);
                ApiService.SetToken(result.Data.AccessToken);
                Nav.NavigateTo("/dashboard", forceLoad: true);
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Login failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
